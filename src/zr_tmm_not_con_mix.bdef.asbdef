managed implementation in class zbp_tmm_not_con_mix unique;
strict ( 2 );
with draft;

define behavior for ZR_TMM_NOT_CON_MIX alias NotConMix
persistent table ztmm_not_con_mix
draft table ztmm_not_con_mid
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( mandatory : create, readonly : update ) Pais;
  field ( mandatory ) Correo;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt, LocalLastChangedAt;

  create;
  update;
  delete;

  validation validarPais   on save { create; field Pais; }
  validation validarCorreo on save { create; update; field Correo; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare
  {
    validation validarPais;
    validation validarCorreo;
  }

  mapping for ztmm_not_con_mix
  {
    Pais               = pais;
    Correo             = correo;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
